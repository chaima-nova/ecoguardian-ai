# Featherless (optional)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-7B-Instruct
FEATHERLESS_HTTP_REFERER=https://ecoguardian.local
FEATHERLESS_X_TITLE=EcoGuardian AI

# ElevenLabs voice briefing (optional)
ELEVENLABS_API_KEY=
