# EcoGuardian AI local development environment

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Backend LLM provider
# Options: mock, anthropic, featherless, gemini
LLM_PROVIDER=mock

# Hosted portfolio demo mode
DEMO_MODE=false

# Anthropic (optional)
